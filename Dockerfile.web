# Web service image: the FastAPI app serves the built PWA and the API under /api.
# No Ollama or Gemma here; the night job keeps its own image (Dockerfile).
#
#   docker build -f Dockerfile.web -t dogear-web \
#     --build-arg VITE_AUTH0_DOMAIN=... --build-arg VITE_AUTH0_CLIENT_ID=... \
#     --build-arg VITE_AUTH0_AUDIENCE=... .
#   docker run --rm -p 10000:10000 --env-file .env dogear-web

FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# Public identifiers only; Vite embeds them in the bundle. Render passes service
# environment variables as build arguments.
ARG VITE_AUTH0_DOMAIN
ARG VITE_AUTH0_CLIENT_ID
ARG VITE_AUTH0_AUDIENCE
RUN npm run build

FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 \
    DOGEAR_WEB_DIST=/app/web/dist

# Cover photos are read with Tesseract's Spanish data, as in local development.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-spa \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev && rm -rf /root/.cache/uv
COPY --from=web /web/dist ./web/dist

# Render sets PORT (10000 by default) and terminates TLS in front of the service.
CMD ["sh", "-c", "exec .venv/bin/uvicorn dogear.entrypoints.web:create_web_app --factory --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips '*'"]
