# Auth0 API verification; public identifiers, not client secrets.
# Replace the domain with your tenant hostname, without https:// or a path.
DOGEAR_AUTH0_DOMAIN=your-tenant.us.auth0.com
DOGEAR_AUTH0_AUDIENCE=https://api.dogear

# Atlas SRV URI without credentials; username/password are passed separately.
DOGEAR_MONGODB_URI=mongodb+srv://your-cluster.mongodb.net/?appName=dogear
DOGEAR_MONGODB_USERNAME=dogear-app
DOGEAR_MONGODB_PASSWORD=
DOGEAR_MONGODB_DATABASE=dogear
# Optional CLI/night-job tracing. Leave empty to disable telemetry.
# Never commit a real DSN. The CLI does not automatically load this file.
DOGEAR_SENTRY_DSN=
